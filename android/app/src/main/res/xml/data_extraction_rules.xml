<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) equivalent of backup_rules.xml. Backups are disabled entirely
     (android:allowBackup="false"), so these rules are inert but kept for documentation. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
