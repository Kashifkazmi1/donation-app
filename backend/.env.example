# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# --- Database (SQLite file path) ---
DATABASE_PATH=./data/donation-terminal.sqlite

# --- Stripe ---
# Secret key for your Stripe account (test: sk_test_..., live: sk_live_...). Never expose this
# to the Android app -- only this backend calls Stripe with it.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret for the webhook endpoint you register in the Stripe Dashboard
# (Developers -> Webhooks -> select/create the endpoint -> "Signing secret").
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# The Stripe Terminal Location ID (tml_...) your M2 readers are registered to.
STRIPE_TERMINAL_LOCATION_ID=tml_replace_me

# --- WordPress / GiveWP bridge plugin ---
# Base URL of the bridge plugin's REST namespace on your WordPress site, e.g.
# https://give.example.org/wp-json/donation-terminal/v1
GIVEWP_API_BASE_URL=https://your-wordpress-site.example.org/wp-json/donation-terminal/v1
# Must match the API key shown on the WordPress site under Settings -> Donation Terminal.
GIVEWP_API_KEY=replace-with-the-plugin-api-key
# Optional: numeric Give Form ID to attribute donations to when a request doesn't specify one.
# Leave blank to let the plugin fall back to its own configured/default form.
GIVEWP_DEFAULT_FORM_ID=

# --- Donation defaults ---
DEFAULT_CURRENCY=usd

# --- CORS ---
# Comma-separated list of allowed origins. Leave blank if the API is only ever called by the
# Android app (which isn't a browser origin and isn't subject to CORS).
CORS_ALLOWED_ORIGINS=

# --- Logging ---
# One of: trace, debug, info, warn, error, silent
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
